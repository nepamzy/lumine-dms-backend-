# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/lumine_dms

# Auth
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email (Brevo transactional email API — HTTPS, works from Render's free tier)
# BREVO_SENDER_EMAIL must be verified in Brevo: Settings > Senders, Domains &
# Dedicated IPs > Add a sender > verify via the confirmation email Brevo sends
BREVO_API_KEY=change_this
BREVO_SENDER_EMAIL=bonchrissupport@gmail.com
BREVO_SENDER_NAME=Lumine Support
BREVO_REPLY_TO=bonchrissupport@gmail.com

# Where contact-form submissions are sent (defaults to BREVO_SENDER_EMAIL if unset)
CONTACT_EMAIL=bonchrissupport@gmail.com

# SMS (Termii - Nigerian SMS gateway)
TERMII_API_KEY=change_this
TERMII_SENDER_ID=Lumine

# CORS
CLIENT_URL=http://localhost:3000

# Set to "true" only on the real deployed (HTTPS) server — controls the
# refresh-token cookie's secure/SameSite flags. Leave unset for local dev
# (NODE_ENV is "production" locally too, for the DB's SSL requirement, so
# this can't be tied to NODE_ENV without breaking local cookies).
COOKIE_SECURE=

# Error monitoring (Sentry) — optional, app runs fine with this unset
SENTRY_DSN=
